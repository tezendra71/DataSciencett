cells:
  - kind: 2
    languageId: sql
    value: "CREATE TABLE employees (\r

      \    employee_id INT PRIMARY KEY,\r

      \    full_name VARCHAR(100),\r

      \    gender VARCHAR(10),\r

      \    department VARCHAR(100),\r

      \    job_title VARCHAR(100),\r

      \    employment_type VARCHAR(50),\r

      \    location VARCHAR(100),\r

      \    hire_date DATE,\r

      \    monthly_salary_bdt DECIMAL(10, 2),\r

      \    manager_id INT\r

      );"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "    Create table reviews (\r

      \        employee_id INT,\r

      \        review_period_start DATE,\r

      \        review_period_end DATE,\r

      \        performance_rating DECIMAL(3, 2),\r

      \        manager_score DECIMAL(5, 2),\r

      \        peer_score DECIMAL(5, 2),\r

      \        bonus_pct DECIMAL(5, 2),\r

      \        trainings_completed INT,\r

      \        leaves_taken INT,\r

      \        attrition_risk BOOLEAN\r

      \r

      );"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "ALTER TABLE employees\r

      ADD CONSTRAINT employees_employee_id_unique UNIQUE (employee_id);\r

      \r\n"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "ALTER TABLE reviews\r

      ADD CONSTRAINT reviews_employee_id_fk\r

      FOREIGN KEY (employee_id) REFERENCES employees(employee_id);"
    metadata: {}
  - kind: 2
    languageId: sql
    value: SELECT * From employees;
    metadata: {}
  - kind: 2
    languageId: sql
    value: SELECT * FROM reviews;
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT *\r

      FROM employees\r

      WHERE manager_id IS NULL OR manager_id = '';"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT\r

      \    employee_id,\r

      \    full_name, department, job_title\r

      FROM\r

      \    employees\r

      WHERE\r

      \    manager_id IS NULL or manager_id = '';"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT DISTINCT department, COUNT(employee_id) AS total_employees\r

      FROM employees\r

      GROUP BY department;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT DISTINCT employment_type, COUNT(employee_id) AS total_employees\r

      FROM employees\r

      GROUP BY employment_type;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT department , employment_type, COUNT(employee_id) AS
      total_employees\r

      FROM employees\r

      Group BY department, employment_type;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT department, ROUND(AVG(monthly_salary_bdt), 2) AS average_salary\r

      FROM employees\r

      GROUP BY department;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT location, ROUND(AVG(monthly_salary_bdt), 2) AS average_salary\r

      FROM employees\r

      GROUP BY location\r

      ORDER BY average_salary DESC;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT department , Round(AVG(performance_rating), 2) AS
      average_performance_rating\r

      FROM reviews Join employees ON reviews.employee_id =
      employees.employee_id\r

      GROUP BY department\r

      ORDER BY average_performance_rating DESC;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT department, \r

      \    ROUND(AVG(manager_score), 2) AS average_manager_score, \r

      \    ROUND(AVG(peer_score), 2) AS average_peer_score\r

      FROM reviews JOIN employees ON reviews.employee_id =
      employees.employee_id\r

      GROUP BY department\r

      ORDER BY average_manager_score DESC, average_peer_score DESC;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT department, attrition_risk, COUNT(employees.employee_id) AS
      Potential_Attrition\r

      From reviews JOIN employees ON reviews.employee_id =
      employees.employee_id\r

      GROUP BY department, attrition_risk\r

      ORDER BY Potential_Attrition DESC;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT department, full_name, (monthly_salary_bdt * bonus_pct) AS
      Bonus_Amount \r

      FROM employees join reviews ON employees.employee_id =
      reviews.employee_id\r

      ORDER BY Bonus_Amount DESC\r

      LIMIT 10;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT department, Count(trainings_completed) AS
      Total_Trainings_Completed, Round(AVG(leaves_taken), 0) AS
      Average_Leaves_Taken\r

      FROM reviews JOIN employees ON reviews.employee_id =
      employees.employee_id\r

      GROUP BY department\r

      ORDER BY Total_Trainings_Completed DESC, Average_Leaves_Taken ASC;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    department,\r

      \    ROUND(AVG(EXTRACT(YEAR FROM AGE(CURRENT_DATE, hire_date))), 0) AS
      avg_tenure_years\r

      FROM employees\r

      GROUP BY department\r

      ORDER BY avg_tenure_years DESC;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "SELECT \r

      \    e.department,\r

      \    ROUND(\r

      \        AVG(EXTRACT(YEAR FROM AGE(CURRENT_DATE, e.hire_date))),0\r

      \    ) AS avg_tenure,\r

      \    ROUND(\r

      \        100.0 * COUNT(*) FILTER (WHERE r.attrition_risk = 'High')\r

      \        / NULLIF(COUNT(*), 0),0\r

      \    ) AS high_risk_pct\r

      FROM employees AS e\r

      JOIN reviews AS r\r

      \    ON r.employee_id = e.employee_id\r

      GROUP BY e.department\r

      ORDER BY avg_tenure DESC;"
    metadata: {}
metadata:
  conn:
    id: ZYBk86KCFZ2z-86jKDZYi
    name: postgres
  database: Human Resources
  schema: public
